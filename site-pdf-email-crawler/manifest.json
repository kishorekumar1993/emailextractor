{
  "manifest_version": 3,
  "name": "Site & PDF Email Crawler",
  "version": "1.1.0",
  "description": "Crawls same-origin pages and PDFs (including image OCR) to extract emails with exact source URLs and PDF links.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
